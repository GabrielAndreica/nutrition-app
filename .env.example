# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional, local ops only: used by psql to apply live migrations. Never expose this in frontend or hosting public vars.
SUPABASE_DB_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# OpenAI API Key (for meal plan generation)
OPENAI_API_KEY=your_openai_api_key

# Resend API Key (for email invitations)
RESEND_API_KEY=your_resend_api_key

# Application URL (for email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional, required for external cron calls in production
CRON_SECRET=your_random_cron_secret
# Optional, protects detailed /api/health output in production monitoring
HEALTH_CHECK_TOKEN=your_random_health_check_token
# Optional, local/dev only. Ignored in production.
DISABLE_RATE_LIMITS=false
# Optional, local/dev only. Makes the weekly check-in card available without waiting for Sunday.
FORCE_WEEKLY_CHECKIN=false

# Stripe subscriptions
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_COACH_PRICE_ID=price_your_coach_monthly_price_id

# Marketing pixels (optional; disabled by default)
NEXT_PUBLIC_MARKETING_PIXELS_ENABLED=false
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
NEXT_PUBLIC_TIKTOK_PIXEL_ID=D88096BC77U8EJN006R0
